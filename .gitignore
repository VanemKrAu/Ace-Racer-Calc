# 临时文件
.agent_tmp/
.agent_reports/
*.tmp
node_modules/

# 技能图标（计算器不调用；本地保留、不入库）
data/*/full/assets/*/skill-icons/

# 皮肤图片（计算器不调用；本地保留、不入库）
data/*/full/assets/*/skins/

# 小尺寸车身图（站点只用 _m 尺寸）
data/*/full/assets/*/body/*_s.png

# 数据集自带的聚合清单（站点与脚本都不读，且永远停留在导入当天的快照）
data/*/full/vehicles.json
data/*/full/vehicle-index.json
data/*/full/manifest.json

# 原始导出包（仓库不再是数据入口：用 update.mjs --from <导出根> 或投到 updata/）
data/*/single-*/

# ZIP 压缩包
data/*/full/packages/
*.zip

# 本地暂存的原始导出包（updata/ 手工投放，不入库）
updata/

# 演示视频（不进仓库）
video/
